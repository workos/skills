{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "all",
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "printWidth": 120,
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    "pnpm-lock.yaml",
    "CHANGELOG.md",
    "query-spec.cjs",
    "plugins/workos/.codex-plugin/plugin.json"
  ]
}
